{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archi Savvy Studio ERP",
  "version": "18.5.0",
  "identifier": "com.archisavvy.studioerp",
  "mainBinaryName": "ArchiSavvyStudioERP",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "splash.html",
        "title": "Archi Savvy Studio ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Archi Savvy Studio ERP"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Archi Savvy Studio",
    "copyright": "Copyright Archi Savvy Studio (modifications). Based on OpenBusinessERP, Copyright Artem Boiko / DataDrivenConstruction. Licensed under AGPL-3.0-or-later.",
    "category": "Business",
    "shortDescription": "ERP for architecture and design practices.",
    "longDescription": "Archi Savvy Studio ERP is practice-management and ERP software for architecture and design studios: projects, clients, quotes, invoices, accounting, documents, drawings and cost planning. It runs fully local on an embedded database and works offline. It is based on OpenBusinessERP (open source) and licensed under AGPL-3.0.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/archisavvy-erp-server"
    ],
    "resources": {
      "resources/converters": "converters"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Dutch",
          "Polish",
          "Norwegian",
          "Swedish",
          "Bulgarian",
          "Russian",
          "Turkish",
          "Arabic",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Vietnamese"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ],
        "section": "science"
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
